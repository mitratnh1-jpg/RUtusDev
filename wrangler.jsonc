{
  "name": "rutusdev",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./web/dist", "binding": "ASSETS", "run_worker_first": ["/api/*", "/media/*", "/articles", "/articles/*", "/work/*", "/sitemap.xml", "/robots.txt"] },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "rutusdev-media" }],
  "vars": {
    "SUPABASE_URL": "https://GANTI.supabase.co",
    "SUPABASE_ANON_KEY": "GANTI_ANON_KEY",
    "ALLOWED_ORIGIN": "https://rutusdev.com"
  }
}
