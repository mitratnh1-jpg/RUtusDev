{
  "name": "rutusdev",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "assets": { "directory": "./web/dist", "binding": "ASSETS", "run_worker_first": ["/api/*", "/media/*", "/articles", "/articles/*", "/work/*", "/services/*", "/sitemap.xml", "/robots.txt", "/admin/config.js"] },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "rutusdev-media" }],
  // Cloudflare Images (binding): gambar disajikan dalam AVIF/WebP dengan ukuran responsif (?w=…). Tanpa binding = berkas asli.
  // Perlu mengaktifkan Images di dashboard Cloudflare (kuota gratis: 5.000 transformasi unik/bulan; hasilnya di-cache).
  "images": { "binding": "IMAGES" },
  // Rate Limiting binding bawaan Cloudflare (aktif juga di *.workers.dev). period hanya boleh 10 atau 60 detik.
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "RATE_LIMITER_ADMIN", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
    // Chatbot publik (/api/chat): 10 pesan/menit/IP.
    { "name": "RATE_LIMITER_CHAT", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } }
  ],
  // Chatbot "Asisten RUtusdev" memakai Cloudflare Workers AI (tanpa API key). Kuota gratis dihitung harian; bila habis/mati,
  // chatbot otomatis memakai FAQ bawaan (shared/chatFaq.ts). Opsional (variabel biasa): CHAT_MODEL, CHAT_ENABLED="false".
  "ai": { "binding": "AI" },
  // Cloudflare menjadikan berkas ini sumber kebenaran: setiap `wrangler deploy` MENGGANTI seluruh set vars di dashboard dengan isi
  // blok "vars" di bawah. Itu sebabnya variabel yang hanya diisi lewat dashboard "hilang" setiap deploy.
  // keep_vars = true mencegah penghapusan itu (variabel dashboard yang TIDAK ada di berkas ini dibiarkan).
  "keep_vars": true,
  // STRATEGI (lihat docs/ENV.md):
  //  1) Hanya flag operasional TIDAK rahasia yang ditulis di sini (ikut git, selalu konsisten setiap deploy).
  //  2) Nilai yang mengungkap arsitektur/backend atau data pribadi disimpan sebagai SECRET (tidak ikut git, tidak pernah ditimpa deploy):
  //     SUPABASE_URL, SUPABASE_ANON_KEY, NOTIFY_TO, SUPABASE_SERVICE_ROLE_KEY, TURNSTILE_SECRET, RESEND_API_KEY, NOTIFY_WEBHOOK_URL, CF_API_TOKEN.
  //  3) TURNSTILE_SITE_KEY (publik) cukup di dashboard sebagai variabel biasa; dilindungi keep_vars.
  "vars": {
    "ALLOWED_ORIGIN": "https://rutusdev.com",
    // "1" = admin WAJIB MFA. Daftarkan MFA di tab Keamanan & Log dulu (akun tanpa MFA hanya bisa membuka tab itu).
    "REQUIRE_MFA": "1",
    // "0" = Content-Security-Policy memblokir. Ubah sementara ke "1" (hanya melapor) bila ada fitur rusak setelah deploy.
    "CSP_REPORT_ONLY": "0",
    // Diagnostik sementara (/api/diag). Biarkan "0" di produksi.
    "DIAG": "0"
  }
}
