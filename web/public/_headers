# Header untuk berkas statis yang disajikan langsung oleh Cloudflare (landing, /admin/, /assets/*).
# Berkas statis TIDAK melewati Worker, jadi header di worker/security.ts tidak menjangkaunya; file ini yang menutup celah itu.
# CSP diberlakukan (memblokir) di landing maupun panel admin. Bila menambah skrip/font/embed pihak ketiga, tambahkan
# domainnya di CSP di bawah DAN di worker/security.ts, atau aset itu akan diblokir.
# microphone=(self): dibutuhkan fitur suara chatbot di landing (hanya origin sendiri; panel admin tidak memakainya).
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), bluetooth=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(self), midi=(), payment=(), serial=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self' https://cloudflareinsights.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'; upgrade-insecure-requests

/admin/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self'; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store
  Cross-Origin-Resource-Policy: same-origin
